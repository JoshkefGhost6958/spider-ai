# ==============================================================================
# Spider AI - Environment Configuration Template
# Copy this file to .env and configure with your production credentials.
# NEVER commit your actual .env file or real secrets to source control!
# ==============================================================================

# Google Gemini API Key (Required for LLM Orchestration, Intent Classification & Synthesis)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Django Security Secret Key (Generate a cryptographically secure random string for production)
# Example generator: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=generate-a-secure-production-secret-key-here

# Debug Mode: Set to False in production environments!
DJANGO_DEBUG=False

# Allowed Hostnames (Comma-separated list of host/domain names this site can serve)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-domain.com

# CSRF Trusted Origins (Comma-separated list of origins for POST requests and secure websockets)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-domain.com

# Server Port (Default: 8000)
PORT=8000
